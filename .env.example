# ============================================
# EEE Batch Pulse — Environment Variables Template
# Copy this file to .env.local and fill in your values
# ============================================

# 1. Supabase Cloud Configuration (Required for Cloud Sync & Realtime Chat)
# Obtain these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. VAPID Keys for Web Push Notifications (Optional - for phone push alerts)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@eeebatch.com
